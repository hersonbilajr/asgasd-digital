# ---------------------------------------------------------------------------
# Asgasd Digital - exemplo de configuracao.
# Copie este ficheiro para ".env" (ou .env.local) e preencha os valores reais.
# NUNCA faca commit do ficheiro .env com credenciais verdadeiras.
# ---------------------------------------------------------------------------

# Base de dados PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/asgasd
DATABASE_USERNAME=asgasd
DATABASE_PASSWORD=trocar-esta-password

# Porta HTTP da aplicacao
PORT=8080

# URL publica usada nos links de recuperacao de palavra-passe
APP_BASE_URL=http://localhost:8080

# Pasta onde sao guardadas as imagens carregadas pelo painel administrativo
UPLOAD_DIR=./uploads

# Conta de administrador criada no primeiro arranque (altere a palavra-passe)
ADMIN_EMAIL=admin@asgasd.co.mz
ADMIN_PASSWORD=trocar-esta-password

# Conta de cliente demonstrativa criada no primeiro arranque
CLIENTE_PASSWORD=trocar-esta-password

# Semear catalogo demonstrativo (true/false)
SEED_DEMO=true

# Servidor de email (opcional - usado na recuperacao de palavra-passe).
# Se nao for configurado, o link de recuperacao e escrito no log da aplicacao.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responder@asgasd.co.mz
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ---------------------------------------------------------------
# Variaveis usadas pelos testes automatizados (PostgreSQL)
# ---------------------------------------------------------------
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/asgasd_test
TEST_DATABASE_USERNAME=asgasd
TEST_DATABASE_PASSWORD=trocar-esta-password
